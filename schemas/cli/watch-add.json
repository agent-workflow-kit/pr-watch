{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "pr-watch/cli/watch-add.json",
  "title": "watch add --json",
  "description": "changed is false when the owner and labels were already present. baselined is false for a query watch, for --no-baseline and when a digest already existed. cursor is the events head read in the same transaction as the write.",
  "type": "object",
  "properties": {
    "watch": {
      "$ref": "../defs.json#/$defs/watch"
    },
    "created": {
      "type": "boolean"
    },
    "changed": {
      "type": "boolean"
    },
    "owner": {
      "$ref": "../defs.json#/$defs/owner"
    },
    "baselined": {
      "type": "boolean"
    },
    "events_emitted": {
      "type": "integer",
      "minimum": 0
    },
    "cursor": {
      "$ref": "../defs.json#/$defs/cursor"
    }
  },
  "additionalProperties": false,
  "required": [
    "watch",
    "created",
    "changed",
    "owner",
    "baselined",
    "events_emitted",
    "cursor"
  ]
}
